<Window x:Class="MapDisk.JanelaOpcoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource JanelaMT}"
        Title="Opções do MapDisk - MT" Width="600" SizeToContent="Height" MaxHeight="840" ResizeMode="NoResize"
        Icon="pack://application:,,,/mapdisk;component/recursos/mapdisk.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource GradienteFaixa}" Padding="18,12">
            <TextBlock Text="Opções" Foreground="White" FontSize="18" FontWeight="ExtraBold" />
        </Border>
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource GradienteLinha}" />

        <!-- Rodape: salvar grava os numeros; o Explorer, os alvos e o registro agem na hora -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,14">
            <Button Content="Cancelar" Style="{StaticResource BotaoContorno}" IsCancel="True" />
            <Button Content="Salvar" Style="{StaticResource BotaoPilula}" Background="{StaticResource PincelVerde}"
                    Foreground="White" BorderBrush="{StaticResource PincelVerde}" IsDefault="True" Click="AoSalvar" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18,14,18,8">
                <!-- Item do menu do Explorer (R19), so no registro do usuario -->
                <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource BarraTitulo}" />
                            <TextBlock Text="Menu do Explorer" Style="{StaticResource TituloCartao}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PincelTextoSuave}"
                                   Text="Põe &quot;Analisar com MapDisk&quot; no botão direito das pastas e das unidades, só para o seu usuário. No Windows 11, o item fica em &quot;Mostrar mais opções&quot;. Se o mapdisk.exe mudar de lugar, ligue de novo." />
                        <TextBlock x:Name="TextoExplorer" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BotaoLigar" Content="Ligar" Style="{StaticResource BotaoContorno}" Click="AoLigar" Margin="0,0,6,0" />
                            <Button x:Name="BotaoDesligar" Content="Desligar" Style="{StaticResource BotaoContorno}" Click="AoDesligar" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource BarraTitulo}" />
                            <TextBlock Text="Análises" Style="{StaticResource TituloCartao}" />
                        </StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Maiores arquivos (10 a 1000)" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="CampoMaiores" Width="56" Margin="0,0,16,0" AutomationProperties.Name="Maiores arquivos" />
                            <TextBlock Text="Duplicados a partir de (MB)" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="CampoMinimoDuplicados" Width="56" AutomationProperties.Name="Duplicados a partir de, em MB" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Pastas que a varredura nao le. Gravam na hora e valem na proxima varredura -->
                <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource BarraTitulo}" />
                            <TextBlock Text="Pastas excluídas da varredura" Style="{StaticResource TituloCartao}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PincelTextoSuave}" Margin="0,0,0,8"
                                   Text="A varredura não lê estas pastas. O nome, como node_modules, vale em qualquer nível. O caminho completo, como D:\Backup\Veeam, vale só para aquela pasta. A pasta excluída aparece como &quot;excluída&quot;, fora dos totais. Vale na próxima varredura." />
                        <ListBox x:Name="ListaExcluidas" Height="90" Margin="0,0,0,8" AutomationProperties.Name="Pastas excluídas da varredura" />
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Acrescentar" Style="{StaticResource BotaoContorno}" Click="AoAcrescentarExcluida" Margin="6,0,6,0" />
                                <Button Content="Escolher pasta..." Style="{StaticResource BotaoContorno}" Click="AoEscolherExcluida" Margin="0,0,6,0" />
                                <Button Content="Tirar" Style="{StaticResource BotaoContorno}" Click="AoTirarExcluida" Margin="0"
                                        ToolTip="Tira da lista a pasta selecionada" />
                            </StackPanel>
                            <TextBox x:Name="CampoExcluir" VerticalContentAlignment="Center" AutomationProperties.Name="Nome ou caminho da pasta a excluir" />
                        </DockPanel>
                        <TextBlock x:Name="TextoErroExcluir" TextWrapping="Wrap" Foreground="#B3261E" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource BarraTitulo}" />
                            <TextBlock Text="Relatório para o cliente: critérios do Sugerir" Style="{StaticResource TituloCartao}" />
                        </StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Maiores pastas" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="CampoPastas" Width="44" Margin="0,0,12,6" AutomationProperties.Name="Maiores pastas" />
                            <TextBlock Text="Maiores arquivos" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="CampoArquivos" Width="44" Margin="0,0,12,6" AutomationProperties.Name="Maiores arquivos do Sugerir" />
                            <TextBlock Text="Sem alteração há mais de (anos)" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="CampoAnos" Width="36" Margin="0,0,12,6" AutomationProperties.Name="Anos sem alteração" />
                            <TextBlock Text="Tamanho mínimo (MB)" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="CampoMinimo" Width="56" Margin="0,0,0,6" AutomationProperties.Name="Tamanho mínimo em MB" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource BarraTitulo}" />
                            <TextBlock Text="Últimos alvos" Style="{StaticResource TituloCartao}" />
                        </StackPanel>
                        <ListBox x:Name="ListaAlvos" Height="90" Margin="0,0,0,8" AutomationProperties.Name="Últimos alvos" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Esquecer" Style="{StaticResource BotaoContorno}" Click="AoEsquecer" Margin="0,0,6,0"
                                    ToolTip="Tira da lista o alvo selecionado" />
                            <Button Content="Limpar a lista" Style="{StaticResource BotaoContorno}" Click="AoLimpar" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Cartao}" Margin="0,0,0,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Style="{StaticResource BarraTitulo}" />
                            <TextBlock Text="Registro de ações" Style="{StaticResource TituloCartao}" />
                        </StackPanel>
                        <TextBlock x:Name="TextoRegistro" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="Abrir" Style="{StaticResource BotaoContorno}" Click="AoAbrirRegistro" HorizontalAlignment="Left" Margin="0"
                                ToolTip="Mostra no Explorer o arquivo com o registro de cada ação" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
