<Window x:Class="MapDisk.JanelaConfirmacao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource JanelaMT}"
        Width="680" SizeToContent="Height" ResizeMode="NoResize"
        Icon="pack://application:,,,/mapdisk;component/recursos/mapdisk.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource GradienteFaixa}" Padding="18,12">
            <TextBlock x:Name="TextoTitulo" Foreground="White" FontSize="18" FontWeight="ExtraBold" />
        </Border>
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource GradienteLinha}" />

        <!-- Cancelar e o padrao: Enter e Esc nao confirmam nada -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,14">
            <Button x:Name="BotaoCancelar" Content="Cancelar" Style="{StaticResource BotaoContorno}" IsCancel="True" IsDefault="True" />
            <Button x:Name="BotaoAgir" Style="{StaticResource BotaoPilula}" Background="{StaticResource PincelVerde}"
                    Foreground="White" BorderBrush="{StaticResource PincelVerde}" Click="AoAgir" />
        </StackPanel>

        <Border Style="{StaticResource Cartao}" Margin="18,14,18,14">
            <StackPanel>
                <TextBlock x:Name="TextoPergunta" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ItemsControl x:Name="ListaAvisos" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource PincelVerdeEscuro}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListView x:Name="ListaItens" MaxHeight="240" Margin="0,10,0,0" BorderBrush="{StaticResource PincelBorda}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nome" Width="180" DisplayMemberBinding="{Binding Nome}" />
                            <GridViewColumn Header="Tamanho" Width="90" DisplayMemberBinding="{Binding TextoTamanho}" />
                            <GridViewColumn Header="Caminho" Width="340" DisplayMemberBinding="{Binding Caminho}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="TextoTotal" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock x:Name="TextoDestino" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />

                <!-- Exclusao definitiva: so liga com EXCLUIR digitado -->
                <StackPanel x:Name="PainelExcluir" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="Digite EXCLUIR para confirmar:" FontWeight="SemiBold" />
                    <TextBox x:Name="CampoExcluir" Width="200" HorizontalAlignment="Left" Margin="0,4,0,0"
                             TextChanged="AoDigitarExcluir" AutomationProperties.Name="Digite EXCLUIR para confirmar" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
