<Window x:Class="MapDisk.JanelaRelatorio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource JanelaMT}"
        Title="Relatório para o cliente - MapDisk - MT" Width="1000" Height="680" MinWidth="760" MinHeight="480"
        Icon="pack://application:,,,/mapdisk;component/recursos/mapdisk.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource GradienteFaixa}" Padding="18,12">
            <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="18" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource GradienteLinha}" />

        <!-- Cliente, tecnico, mensagem e Gerar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Cartao}" Margin="14,0,14,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Fechar" Style="{StaticResource BotaoContorno}" IsCancel="True" Click="AoFechar" />
                    <Button Content="Gerar..." Style="{StaticResource BotaoPilula}" Background="{StaticResource PincelVerde}"
                            Foreground="White" BorderBrush="{StaticResource PincelVerde}" Click="AoGerar" />
                </StackPanel>
                <Grid Margin="0,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Cliente:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Grid.Column="1" Text="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,4"
                             AutomationProperties.Name="Cliente" />
                    <TextBlock Grid.Column="2" Text="Técnico:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Grid.Column="3" Text="{Binding Tecnico, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                             AutomationProperties.Name="Técnico" />
                    <TextBlock Grid.Row="1" Text="Mensagem:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Mensagem, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Mensagem para o cliente" />
                </Grid>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Cartao}" Margin="14,14,14,10">
            <DockPanel>
                <!-- Criterios do Sugerir -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Maiores pastas" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="CampoPastas" Width="44" Margin="0,0,12,0" AutomationProperties.Name="Maiores pastas" />
                    <TextBlock Text="Maiores arquivos" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="CampoArquivos" Width="44" Margin="0,0,12,0" AutomationProperties.Name="Maiores arquivos" />
                    <TextBlock Text="Sem alteração há mais de (anos)" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="CampoAnos" Width="36" Margin="0,0,12,0" AutomationProperties.Name="Anos sem alteração" />
                    <TextBlock Text="Tamanho mínimo (MB)" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="CampoMinimo" Width="56" Margin="0,0,12,0" AutomationProperties.Name="Tamanho mínimo em MB" />
                    <Button x:Name="BotaoSugerir" Content="Sugerir" Style="{StaticResource BotaoContorno}" Click="AoSugerir" Margin="0,0,6,0" />
                    <Button Content="Acrescentar a seleção" Style="{StaticResource BotaoContorno}" Click="AoAcrescentar" Margin="0,0,6,0"
                            ToolTip="Traz o que está selecionado na árvore ou nas listas de análise" />
                    <Button Content="Tirar da lista" Style="{StaticResource BotaoContorno}" Click="AoTirar" Margin="0" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding TextoTotal}" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ListView x:Name="Lista" ItemsSource="{Binding Linhas}" SelectionMode="Extended" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nº" Width="40" DisplayMemberBinding="{Binding Numero}" />
                            <GridViewColumn Header="Nome" Width="180" DisplayMemberBinding="{Binding Nome}" />
                            <GridViewColumn Header="Tipo" Width="60" DisplayMemberBinding="{Binding Tipo}" />
                            <GridViewColumn Header="Tamanho" Width="80" DisplayMemberBinding="{Binding TextoTamanho}" />
                            <GridViewColumn Header="Arquivos" Width="70" DisplayMemberBinding="{Binding TextoArquivos}" />
                            <GridViewColumn Header="Última alteração" Width="110" DisplayMemberBinding="{Binding TextoData}" />
                            <GridViewColumn Header="Motivo" Width="220" DisplayMemberBinding="{Binding Motivo}" />
                            <GridViewColumn Header="Caminho" Width="300" DisplayMemberBinding="{Binding Caminho}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
