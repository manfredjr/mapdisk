# Pagina estatica do MapDisk - MT. Sem listagem de pasta e com cabecalhos de seguranca.
Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
</IfModule>
